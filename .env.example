# ── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB Atlas ────────────────────────────────────────
# Create a free cluster at https://cloud.mongodb.com
# Replace <user>, <password>, and cluster URL with your values
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/faceattend?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=24h

# ── Cloudinary ───────────────────────────────────────────
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / OTP (Gmail SMTP recommended) ─────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Python Face Service ─────────────────────────────────
PYTHON_SERVICE_URL=http://localhost:5001

# ── Admin Seed (used by setup.js) ────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@faceattend.com
